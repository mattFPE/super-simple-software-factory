{
  "name": "sssf-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Console for the Super Simple Software Factory — launches ADWs and watches their Runs by polling sssf.db in a target repo.",
  "scripts": {
    "dev": "vite",
    "server": "bun run server/index.ts",
    "dev:all": "bun run server/index.ts & vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "bun run server/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint .",
    "test": "bun test"
  },
  "dependencies": {
    "@fontsource/play": "^5.3.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@vitejs/plugin-vue": "^6",
    "oxlint": "^1",
    "typescript": "^5.7.2",
    "vite": "^7",
    "vue-tsc": "^3"
  }
}
